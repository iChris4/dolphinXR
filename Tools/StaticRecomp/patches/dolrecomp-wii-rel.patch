 #include <time.h>
+
+/* DolphinXR: --direct-calls, and the chunk entries of another tree (--extern-chunks). */
+static int g_direct_calls = 0;
+static u32* g_extern_chunk_starts = NULL;
+static u32 g_extern_chunk_count = 0;
+
+static int compare_u32(const void* left, const void* right) {
+    const u32 a = *(const u32*)left;
+    const u32 b = *(const u32*)right;
+    return a < b ? -1 : a > b ? 1 : 0;
+}
+
+int pipeline_set_direct_calls(const char* extern_header) {
+    g_direct_calls = 1;
+    if (!extern_header)
+        return 1;
+    FILE* header = fopen(extern_header, "r");
+    if (!header) {
+        fprintf(stderr, "error: cannot read %s\n", extern_header);
+        return 0;
+    }
+    /* Each chunk is declared "void func_XXXXXXXX(CPUState* ctx);" in its tree's generated.h. */
+    char line[256];
+    u32 capacity = 0;
+    while (fgets(line, sizeof(line), header)) {
+        unsigned address = 0;
+        if (sscanf(line, "void func_%8X(CPUState* ctx);", &address) != 1)
+            continue;
+        if (g_extern_chunk_count == capacity) {
+            capacity = capacity ? capacity * 2u : 256u;
+            u32* grown = (u32*)realloc(g_extern_chunk_starts, capacity * sizeof(u32));
+            if (!grown) {
+                fclose(header);
+                return 0;
+            }
+            g_extern_chunk_starts = grown;
+        }
+        g_extern_chunk_starts[g_extern_chunk_count++] = address;
+    }
+    fclose(header);
+    if (g_extern_chunk_count == 0) {
+        fprintf(stderr, "error: no chunks declared in %s\n", extern_header);
+        return 0;
+    }
+    return 1;
+}
 #ifndef _WIN32
 #include <sys/wait.h>
 #include <unistd.h>
