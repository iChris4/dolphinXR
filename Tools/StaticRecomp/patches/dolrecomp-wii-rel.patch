diff --git a/src/app/pipeline.c b/src/app/pipeline.c
index a154731..5fe5e9b 100644
--- a/src/app/pipeline.c
+++ b/src/app/pipeline.c
@@ -24,6 +24,273 @@
 #include <string.h>
 #include <errno.h>
 #include <time.h>
+
+/* DolphinXR: --direct-calls, and the chunk entries of another tree (--extern-chunks). */
+static int g_direct_calls = 0;
+static u32* g_extern_chunk_starts = NULL;
+static u32 g_extern_chunk_count = 0;
+
+static int compare_u32(const void* left, const void* right) {
+    const u32 a = *(const u32*)left;
+    const u32 b = *(const u32*)right;
+    return a < b ? -1 : a > b ? 1 : 0;
+}
+
+int pipeline_set_direct_calls(const char* extern_header) {
+    g_direct_calls = 1;
+    if (!extern_header)
+        return 1;
+    FILE* header = fopen(extern_header, "r");
+    if (!header) {
+        fprintf(stderr, "error: cannot read %s\n", extern_header);
+        return 0;
+    }
+    /* Each chunk is declared "void func_XXXXXXXX(CPUState* ctx);" in its tree's generated.h. */
+    char line[256];
+    u32 capacity = 0;
+    while (fgets(line, sizeof(line), header)) {
+        unsigned address = 0;
+        if (sscanf(line, "void func_%8X(CPUState* ctx);", &address) != 1)
+            continue;
+        if (g_extern_chunk_count == capacity) {
+            capacity = capacity ? capacity * 2u : 256u;
+            u32* grown = (u32*)realloc(g_extern_chunk_starts, capacity * sizeof(u32));
+            if (!grown) {
+                fclose(header);
+                return 0;
+            }
+            g_extern_chunk_starts = grown;
+        }
+        g_extern_chunk_starts[g_extern_chunk_count++] = address;
+    }
+    fclose(header);
+    if (g_extern_chunk_count == 0) {
+        fprintf(stderr, "error: no chunks declared in %s\n", extern_header);
+        return 0;
+    }
+    return 1;
+}
+
+static int g_function_chunks = 0;
+
+void pipeline_set_function_chunks(void) {
+    g_function_chunks = 1;
+    emit_set_function_chunks(1);
+    dispatch_set_function_chunks(1);
+}
+
+static int push_u32(u32** items, u32* count, u32* capacity, u32 value) {
+    if (*count == *capacity) {
+        u32 grown_capacity = *capacity ? *capacity * 2u : 1024u;
+        u32* grown = (u32*)realloc(*items, (size_t)grown_capacity * sizeof(u32));
+        if (!grown)
+            return 0;
+        *items = grown;
+        *capacity = grown_capacity;
+    }
+    (*items)[(*count)++] = value;
+    return 1;
+}
+
+/* DolphinXR --function-chunks: decode every section, take each direct call target (bl, bcl)
+ * inside them as the start of a guest function, and make each function -- from its start to
+ * the next one, at most max_chunk instructions -- a chunk of its own: a C function, a guard
+ * granule, a direct-call target. Consecutive chunks of a section share a C file up to
+ * max_chunk instructions. A function only ever reached through a pointer stays in the chunk
+ * before it, which is correct, only coarser. */
+static int emit_function_chunk_sections(const LoadedCodeSection* sections, u32 section_count,
+                                        FILE* header, FILE* manifest, const char* chunks_dir,
+                                        const char* chunks_label, const char* include_name,
+                                        u32 jobs, u32 max_chunk, FunctionList* funcs,
+                                        SMCAnalysis* smc, u32* file_count) {
+    PPCInst** insts = (PPCInst**)calloc(section_count ? section_count : 1u, sizeof(PPCInst*));
+    u32* entries = NULL;
+    u32 entry_count = 0, entry_capacity = 0;
+    ChunkSpan* spans = NULL;
+    u32 span_count = 0, span_capacity = 0;
+    u32* span_section = NULL;
+    ChunkJob* file_jobs = NULL;
+    u32 file_job_count = 0;
+    u32* chunk_starts = NULL;
+    int ok = 0;
+    if (!insts)
+        goto out;
+
+    for (u32 s = 0; s < section_count; s++) {
+        const LoadedCodeSection* section = &sections[s];
+        if (section->size == 0 || !section->data)
+            continue;
+        const u32 num_insts = section->size / 4u;
+        insts[s] = (PPCInst*)malloc((size_t)num_insts * sizeof(PPCInst));
+        if (!insts[s])
+            goto out;
+        u32 embedded = 0, unknown = 0;
+        for (u32 i = 0; i < num_insts; i++) {
+            const u32 raw = read_be32(section->data + i * 4u);
+            insts[s][i] = ppc_decode(raw, section->address + i * 4u);
+            if (insts[s][i].op == PPC_OP_UNKNOWN &&
+                embedded_data_word(section->embedded_data_mode, raw))
+                insts[s][i].embedded_data = true;
+            if (insts[s][i].embedded_data)
+                embedded++;
+            else if (insts[s][i].op == PPC_OP_UNKNOWN)
+                unknown++;
+        }
+        printf("decoding %s[%u]: %u instructions at 0x%08X (%u embedded data, %u unknown)\n",
+               section->label, section->index, num_insts, section->address, embedded, unknown);
+        if (section->embedded_data_mode == EMBEDDED_DATA_DOL) {
+            analyze_smc_section(sections, section_count, insts[s], num_insts, smc);
+            if (smc->allocation_failed)
+                goto out;
+        }
+    }
+
+    /* Function starts: every direct call target inside these sections. */
+    for (u32 s = 0; s < section_count; s++) {
+        if (!insts[s])
+            continue;
+        const u32 num_insts = sections[s].size / 4u;
+        for (u32 i = 0; i < num_insts; i++) {
+            const PPCInst* inst = &insts[s][i];
+            if (inst->embedded_data || !inst->lk ||
+                (inst->op != PPC_OP_B && inst->op != PPC_OP_BC))
+                continue;
+            const u32 target = inst->branch_target;
+            for (u32 t = 0; t < section_count; t++) {
+                if (insts[t] && (target & 3u) == 0 && target >= sections[t].address &&
+                    target - sections[t].address < sections[t].size) {
+                    if (!push_u32(&entries, &entry_count, &entry_capacity, target))
+                        goto out;
+                    break;
+                }
+            }
+        }
+    }
+    qsort(entries, entry_count, sizeof(u32), compare_u32);
+    {
+        u32 unique = 0;
+        for (u32 i = 0; i < entry_count; i++)
+            if (unique == 0 || entries[unique - 1u] != entries[i])
+                entries[unique++] = entries[i];
+        entry_count = unique;
+    }
+
+    /* Chunks: section start and each function start, at most max_chunk instructions. */
+    {
+        u32 e = 0;
+        for (u32 s = 0; s < section_count; s++) {
+            if (!insts[s])
+                continue;
+            const u32 base = sections[s].address;
+            const u32 num_insts = sections[s].size / 4u;
+            e = 0;  /* sections need not come in address order */
+            while (e < entry_count && entries[e] < base)
+                e++;
+            u32 start = 0;
+            while (start < num_insts) {
+                while (e < entry_count && entries[e] <= base + start * 4u)
+                    e++;
+                u32 end = num_insts;
+                if (e < entry_count && entries[e] < base + num_insts * 4u)
+                    end = (entries[e] - base) / 4u;
+                if (end - start > max_chunk)
+                    end = start + max_chunk;
+                if (span_count == span_capacity) {
+                    span_capacity = span_capacity ? span_capacity * 2u : 1024u;
+                    ChunkSpan* grown = (ChunkSpan*)realloc(spans, span_capacity * sizeof(ChunkSpan));
+                    u32* grown_section = (u32*)realloc(span_section, span_capacity * sizeof(u32));
+                    if (grown)
+                        spans = grown;
+                    if (grown_section)
+                        span_section = grown_section;
+                    if (!grown || !grown_section)
+                        goto out;
+                }
+                spans[span_count].insts = insts[s] + start;
+                spans[span_count].count = end - start;
+                spans[span_count].func_addr = base + start * 4u;
+                span_section[span_count] = s;
+                span_count++;
+                start = end;
+            }
+        }
+    }
+    printf("  %u function chunks from %u call targets\n", span_count, entry_count);
+
+    for (u32 i = 0; i < span_count; i++) {
+        emit_chunk_prototype(header, spans[i].func_addr);
+        if (!function_list_add(funcs, spans[i].func_addr,
+                               spans[i].func_addr + spans[i].count * 4u))
+            goto out;
+    }
+
+    if (g_direct_calls) {
+        const u32 total = funcs->count + g_extern_chunk_count;
+        chunk_starts = (u32*)malloc((size_t)(total ? total : 1u) * sizeof(u32));
+        if (!chunk_starts)
+            goto out;
+        for (u32 i = 0; i < funcs->count; ++i)
+            chunk_starts[i] = funcs->ranges[i].start;
+        for (u32 i = funcs->count; i < total; ++i)
+            chunk_starts[i] = g_extern_chunk_starts[i - funcs->count];
+        qsort(chunk_starts, total, sizeof(u32), compare_u32);
+        emit_set_direct_call_guard(1);
+        emit_set_chunk_table(chunk_starts, total);
+        printf("  guarded direct calls (%u external chunks)\n", g_extern_chunk_count);
+    }
+
+    /* Files: consecutive chunks of one section, up to max_chunk instructions each. */
+    file_jobs = (ChunkJob*)calloc(span_count ? span_count : 1u, sizeof(ChunkJob));
+    if (!file_jobs)
+        goto out;
+    for (u32 first = 0; first < span_count;) {
+        u32 last = first + 1u, instructions = spans[first].count;
+        while (last < span_count && span_section[last] == span_section[first] &&
+               instructions + spans[last].count <= max_chunk) {
+            instructions += spans[last].count;
+            last++;
+        }
+        const LoadedCodeSection* section = &sections[span_section[first]];
+        ChunkJob* job = &file_jobs[file_job_count++];
+        char chunk_name[128];
+        snprintf(chunk_name, sizeof(chunk_name), "chunk_%04u_%s%u_%08X.c", *file_count,
+                 section->label, section->index, spans[first].func_addr);
+        if (!join_path(job->path, sizeof(job->path), chunks_dir, chunk_name) ||
+            snprintf(job->include_name, sizeof(job->include_name), "%s", include_name) >=
+                (int)sizeof(job->include_name)) {
+            fprintf(stderr, "error: chunk path is too long\n");
+            goto out;
+        }
+        job->spans = &spans[first];
+        job->span_count = last - first;
+        job->func_addr = spans[first].func_addr;
+        fprintf(manifest, "// %s/%s\n", chunks_label, chunk_name);
+        (*file_count)++;
+        first = last;
+    }
+    {
+        u32 active_jobs = effective_chunk_jobs(file_job_count, jobs);
+        printf("  writing %u files with %u job%s\n", file_job_count, active_jobs,
+               active_jobs == 1 ? "" : "s");
+    }
+    ok = run_chunk_jobs(file_jobs, file_job_count, jobs);
+
+out:
+    if (!ok)
+        fprintf(stderr, "error: function chunk output failed\n");
+    emit_set_chunk_table(NULL, 0);
+    free(chunk_starts);
+    free(file_jobs);
+    free(span_section);
+    free(spans);
+    free(entries);
+    if (insts) {
+        for (u32 s = 0; s < section_count; s++)
+            free(insts[s]);
+        free(insts);
+    }
+    return ok;
+}
