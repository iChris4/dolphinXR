+/* DolphinXR: beside a REL's generated code, what a module needs to find the REL in the game's
+ * RAM and to verify its code there. rel_layout.txt: the header fields Dolphin's StaticRecomp core
+ * matches and each section's linked address. rel_image.dol: the relocated executable sections as
+ * a DOL at their linked addresses (the bytes the game has in RAM once it linked the REL there),
+ * which the module template hashes as it hashes main.dol. */
+static int write_rel_layout(const RELFile* rel, const char* generated_c_path) {
+    char dir[1200];
+    snprintf(dir, sizeof(dir), "%s", generated_c_path);
+    char* slash = strrchr(dir, '/');
+    if (slash)
+        *slash = '\0';
+    else
+        snprintf(dir, sizeof(dir), ".");
+
+    char path[1300];
+    snprintf(path, sizeof(path), "%s/rel_layout.txt", dir);
+    FILE* layout = fopen(path, "w");
+    if (!layout) {
+        fprintf(stderr, "error: cannot write %s\n", path);
+        return 0;
+    }
+    fprintf(layout, "module_id %u\nversion %u\nsection_count %u\nsection_info_offset 0x%X\n"
+                    "file_size 0x%X\n",
+            rel->module_id, rel->version, rel->section_count, read_be32(rel->file_data + 0x10),
+            rel->file_size);
+    for (u32 i = 0; i < rel->section_count; ++i) {
+        const RELSection* section = &rel->sections[i];
+        if (section->size == 0)
+            continue;
+        fprintf(layout, "section %u 0x%08X 0x%X %s\n", section->index, section->address,
+                section->size, section->bss ? "bss" : section->executable ? "exec" : "data");
+    }
+    fclose(layout);
+
+    /* DOL layout: 7 text section slots (file offset, address, size), then 11 data slots. */
+    u8 header[0x100];
+    memset(header, 0, sizeof(header));
+    u32 text_slot = 0;
+    u32 file_offset = sizeof(header);
+    for (u32 i = 0; i < rel->section_count && text_slot < 7; ++i) {
+        const RELSection* section = &rel->sections[i];
+        if (!section->executable || section->size == 0 || !section->data)
+            continue;
+        write_be32(header + 0x00 + text_slot * 4, file_offset);
+        write_be32(header + 0x48 + text_slot * 4, section->address);
+        write_be32(header + 0x90 + text_slot * 4, section->size);
+        file_offset += section->size;
+        ++text_slot;
+    }
+    snprintf(path, sizeof(path), "%s/rel_image.dol", dir);
+    FILE* image = fopen(path, "wb");
+    if (!image) {
+        fprintf(stderr, "error: cannot write %s\n", path);
+        return 0;
+    }
+    fwrite(header, 1, sizeof(header), image);
+    for (u32 i = 0; i < rel->section_count; ++i) {
+        const RELSection* section = &rel->sections[i];
+        if (section->executable && section->size != 0 && section->data)
+            fwrite(section->data, 1, section->size, image);
+    }
+    fclose(image);
+    printf("  rel layout: %s/rel_layout.txt, %s/rel_image.dol\n", dir, dir);
+    return 1;
+}
